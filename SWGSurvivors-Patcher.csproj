<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>SWGSurvivors_Patcher</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ApplicationIcon>swgs.ico</ApplicationIcon>
    <!-- TODO: Change to SWGSurvivors-Launcher after migration period (matches LAUNCHER_ASSET_NAME in GitHubUpdateService.cs) -->
    <AssemblyName>SWGSurvivors-Patcher</AssemblyName>
    <Version>0.2.5</Version>
    <!-- FileVersion and AssemblyVersion will auto-generate -->
    <Authors>Quandru</Authors>
    <Company>SWGSurvivors</Company>
    <Product>SWGSurvivors Delta Patcher</Product>
    <Description>Lightweight launcher and manifest-based differential patcher with self-update capability for the SWGSurvivors SWGEmu server.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="logo.png" />
  </ItemGroup>

</Project>
